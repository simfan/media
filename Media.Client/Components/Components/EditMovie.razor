@using Microsoft.AspNetCore.Components;
@using Medias.Shared.DTOs;
@using Medias.Shared.Enums;
@using Medias.Shared.Helpers;
@inject HttpClient Http;


<BSForm  TValue="MovieDto" EditContext="EC" OnValidSubmit="ModifyMediaItem">
    <div>
        <BSRow>
            <BSCol>
                @if(Movie != null)
                {
                    <h1>Edit Media Item</h1>
                }
                else
                {
                    <h1>Create Media Item</h1>
                }
            </BSCol>
        </BSRow>
        <BSRow>
            <BSCol>
                <div class="@(BS.Form_Floating) mb-1">
                    <BSInput InputType="InputType.Select" @bind-Value="NewMovie.MediaType">
                        @foreach (var mediaType in Enum.GetValues<MediaTypeValue>())
                        {
                            <option value="@mediaType">
                                @mediaType.GetDisplayName()
                            </option>
                        }
                    </BSInput>
                    <BSLabel IsFloating="true">"Media Type</BSLabel>"
                </div>
            </BSCol>
        </BSRow>
        <BSRow>
            <BSCol>
                <div class="@(@BS.Form_Floating) mb-1">
                <BSInput InputType="InputType.Text" @bind-Value="NewMovie.Title"/>
                <BSLabel IsFloating="true">Title</BSLabel>
                </div>
            </BSCol>
        </BSRow>
        <BSRow>
            <BSCol>
                <div class="@(@BS.Form_Floating) mb-1">
                    <BSInput InputType="InputType.Text" @bind-Value="NewMovie.Description" />
                    <BSLabel IsFloating="true">Description</BSLabel>
                </div>
            </BSCol>
        </BSRow>
        <BSRow>
            <BSCol>
                <div class="@(@BS.Form_Floating) mb-1">
                    <BSInput InputType="InputType.Text" @bind-Value="NewMovie.ThumbnailPath" />
                    <BSLabel IsFloating="true">Location</BSLabel>
                </div>
            </BSCol>
        </BSRow>
        <BSRow>
            <BSCol>
                <div class="@(@BS.Form_Floating) mb-1">
                    <BSInput InputType="InputType.Text" @bind-Value="NewMovie.LibraryId" />
                    <BSLabel IsFloating="true">Library ID (Enter 0 if not assigned)</BSLabel>
                </div>
            </BSCol>
        </BSRow>
    </div>
</BSForm>
@code {
    [Parameter]
    public int MediaItemId { get; set; }
    [Parameter]
    public UpdateMovieDto? Movie{ get; set; }
    public CreateMovieDto NewMovie = new();

    private EditContext EC;
    private int mediaTypeInt;

    protected override void OnParametersSet()
    {
        EC = new EditContext(NewMovie);
        if (Movie != null)
        {
            NewMovie = Movie.ToCreateMovie();
        }
    }

    protected async Task ModifyMediaItem()
    {
        if(MediaItemId != 0)
        {
            Movie = Movie?.LoadFromCreate(NewMovie, Movie);
            await UpdateMediaItem();
        }
        else
        {
            await CreateMediaItem();
        }
    }

    protected async Task CreateMediaItem()
    {
        await Http.PostAsJsonAsync<CreateMediaItemDto>("api/MediaItem", NewMovie);
    }

    protected async Task UpdateMediaItem()
    {
        await Http.PutAsJsonAsync($"api/MediaItem/{MediaItemId}", Movie);        
    }


}
