<Blazor.Sonner.Toaster @rendermode="InteractiveServer" RichColors="@true"/>
@code {
    [Parameter]
    public int MediaItemId { get; set; }
    [Parameter]
    public UpdateMovieDto? Movie{ get; set; }
    public CreateMovieDto NewMovie = new();

    private EditContext EC;
    private int mediaTypeInt;

    protected override void OnParametersSet()
    {
        EC = new EditContext(NewMovie);
        if (Movie != null)
        {
            NewMovie = Movie.ToCreateMovie();
        }
    }

    protected async Task ModifyMediaItem()
    {
        NewMovie.MediaType = MediaTypeValue.Movie;
        if(MediaItemId != 0)
        {
            Movie = Movie?.LoadFromCreate(NewMovie, Movie);
            await UpdateMediaItem();
        }
        else
        {
            await CreateMediaItem();
        }
    }

    protected async Task CreateMediaItem()
    {
        var response = await Http.PostAsJsonAsync<CreateMovieDto>("api/MediaItem/movie", NewMovie);
        if(response.IsSuccessStatusCode)
        {
            MovieDto responseValue = await response.Content.ReadFromJsonAsync<MovieDto>();
            if(responseValue != null)
            {
                Console.WriteLine($"Created Movie: {responseValue.Title}");
                Toast.Success($"Created Movie: {responseValue.Title}");
            }
        }
        else
        {
            Toast.Error($"Could not create Movie: {response.ReasonPhrase}");
        }
    }

    protected async Task UpdateMediaItem()
    {
        Toast.Show("Updating Movie..."); 
        var response = await Http.PutAsJsonAsync($"api/MediaItem/{MediaItemId}/movie", Movie);        
        if(response.IsSuccessStatusCode)
        {
            Console.WriteLine($"Updated Movie: {Movie.Title}");    
            Toast.Success($"Updated Movie:  {Movie.Title}");
        }
    }

    private void ShowToast()
    {
        Toast.Show("This is a toast message!");
    }

}
