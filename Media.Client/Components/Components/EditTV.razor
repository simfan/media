@using Microsoft.AspNetCore.Components;
@using Medias.Shared.DTOs;
@using Medias.Shared.Enums;
@using Medias.Shared.Helpers;
@using Blazor.Sonner;
@using Blazor.Sonner.Services;
@inject HttpClient Http;
@inject ToastService Toast;
@inject NavigationManager Nav;

<div>New TV Show</div>
<BSForm TValue="TelevisionShowDto" EditContext="EC" OnValidSubmit="ModifyMediaItem">
    <div>
        <BSRow>
            <BSCol>
                <div class="@(@BS.Form_Floating) mb-1">
                <BSInput InputType="InputType.Text" @bind-Value="NewShow.Name"/>
                <BSLabel IsFloating="true">Title</BSLabel>
                </div>
            </BSCol>
        </BSRow>
        <BSRow>
            <BSCol>
                <div class="@(@BS.Form_Floating) mb-1">
                    <BSInput InputType="InputType.Text" @bind-Value="NewShow.Description" />
                    <BSLabel IsFloating="true">Description</BSLabel>
                </div>
            </BSCol>
        </BSRow>
        
        <BSRow>
            <BSCol>
                <div class="@(@BS.Form_Floating) mb-1">
                    <BSInput InputType="InputType.Text" @bind-Value="NewShow.CreatedBy" />
                    <BSLabel IsFloating="true">Created By</BSLabel>
                </div>
            </BSCol>
            <BSCol>
                <div class="@(@BS.Form_Floating) mb-1">
                    <BSInput InputType="InputType.Text" @bind-Value="NewShow.Studio" />
                    <BSLabel IsFloating="true">Studio</BSLabel>
                </div>
            </BSCol>
        </BSRow>

        <BSRow>
            <BSCol>
                <div class="@(@BS.Form_Floating) mb-1">
                    <BSInput InputType="InputType.Text" @bind-Value="NewShow.Genre" />
                    <BSLabel IsFloating="true">Genre</BSLabel>
                </div>
            </BSCol>
            <BSCol>
                <div class="@(@BS.Form_Floating) mb-1">
                    <BSInput InputType="InputType.Text" @bind-Value="NewShow.Rating" />
                    <BSLabel IsFloating="true">Rating</BSLabel>
                </div>
            </BSCol>
        </BSRow>
        <BSRow>
            <BSCol>
                <div class="@(@BS.Form_Floating) mb-1">
                    <BSInput InputType="InputType.Text" @bind-Value="NewShow.SeasonCount" />
                    <BSLabel IsFloating="true"># of Seasons</BSLabel>
                </div>
            </BSCol>
        </BSRow>

        <BSRow>
            <BSCol>
                <div class="@(@BS.Form_Floating) mb-1">
                    <BSInput InputType="InputType.Text" @bind-Value="NewShow.TmdbTvId" />
                    <BSLabel IsFloating="true">TMDb ID</BSLabel>
                </div>
            </BSCol>
            <BSCol>
                <div class="@(@BS.Form_Floating) mb-1">
                    <BSInput InputType="InputType.Text" @bind-Value="NewShow.ImdbId" />
                    <BSLabel IsFloating="true">IMDB ID</BSLabel>
                </div>
            </BSCol>
        </BSRow>
        <BSButton Color="BSColor.Primary" IsSubmit>Save</BSButton>
    </div>
</BSForm>
<Blazor.Sonner.Toaster @rendermode="InteractiveServer" RichColors="@true"/>
@code {
    [Parameter]
    public int CollectionId { get; set; }
    [Parameter]
    public UpdateTelevisionShowDto? Show{ get; set; }
    [Parameter]
    public bool? IsModal{ get; set; }
    [Parameter]
    public EventCallback<UpdateTelevisionShowDto> OnShowUpdated { get; set; }

    public CreateTelevisionShowDto NewShow = new();

    private EditContext EC;
    private int mediaTypeInt;

    protected override void OnParametersSet()
    {
        EC = new EditContext(NewShow);
        if (Show != null)
        {
            NewShow = Show.ToCreateTelevisionShow();
        }
    }

    protected async Task ModifyMediaItem()
    {
        @*NewShow.MediaType = MediaTypeValue.TV;*@
        if (CollectionId != 0)
        {
            Show = Show?.LoadFromCreate(NewShow, Show);
            await UpdateCollection();
        }
        else
        {
            await CreateCollection();
        }
    }

    protected async Task CreateCollection()
    {
        Console.WriteLine($"TV Show Details: {NewShow}");
        var response = await Http.PostAsJsonAsync<CreateTelevisionShowDto>("api/Collections/show", NewShow);
        if(response.IsSuccessStatusCode)
        {
            TelevisionShowDto responseValue = await response.Content.ReadFromJsonAsync<TelevisionShowDto>();
            if(responseValue != null)
            {
                Console.WriteLine($"Created TV Show: {responseValue.Name}");
                Toast.Success($"Created TV Show: {responseValue.Name}");
                if(IsModal != null && IsModal == true)
                {
                    Show.CollectionId = responseValue.CollectionId;
                    await OnShowUpdated.InvokeAsync(Show);
                }
            }
        }
        else
        {
            Toast.Error($"Could not create TV Show: {response.ReasonPhrase}");
        }
    }

    protected async Task UpdateCollection()
    {
        Toast.Show("Updating TV Show...");
        var response = await Http.PutAsJsonAsync($"api/Collections/{CollectionId}/tv/show", Show);        
        if(response.IsSuccessStatusCode)
        {
            Console.WriteLine($"Updated TV Show: {Show.Name}");
            Toast.Success($"Updated TV Show:  {Show.Name}");
            await Task.Delay(5000);
            Nav.NavigateTo($"media/{CollectionId}");
                    }
    }

    private void ShowToast()
    {
        Toast.Show("This is a toast message!");
    }

}
