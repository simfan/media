<Blazor.Sonner.Toaster @rendermode="InteractiveServer" RichColors="@true"/>
@code {
    [Parameter]
    public int MediaItemId { get; set; }
    [Parameter]
    public UpdateTelevisionShowDto? Show{ get; set; }
    public CreateTelevisionShowDto NewShow = new();

    private EditContext EC;
    private int mediaTypeInt;

    protected override void OnParametersSet()
    {
        EC = new EditContext(NewShow);
        if (Show != null)
        {
            NewShow = Show.ToCreateTelevisionShow();
        }
    }

    protected async Task ModifyMediaItem()
    {
        NewShow.MediaType = MediaTypeValue.TV;
        if(MediaItemId != 0)
        {
            Show = Show?.LoadFromCreate(NewShow, Show);
            await UpdateMediaItem();
        }
        else
        {
            await CreateMediaItem();
        }
    }

    protected async Task CreateMediaItem()
    {
        Console.WriteLine($"TV Show Details: {NewShow}");
        var response = await Http.PostAsJsonAsync<CreateTelevisionShowDto>("api/MediaItem/tv", NewShow);
        if(response.IsSuccessStatusCode)
        {
            TelevisionShowDto responseValue = await response.Content.ReadFromJsonAsync<TelevisionShowDto>();
            if(responseValue != null)
            {
                Console.WriteLine($"Created TV Show: {responseValue.Title}");
                Toast.Success($"Created TV Show: {responseValue.Title}");
            }
        }
        else
        {
            Toast.Error($"Could not create TV Show: {response.ReasonPhrase}");
        }
    }

    protected async Task UpdateMediaItem()
    {
        Toast.Show("Updating TV Show...");
        var response = await Http.PutAsJsonAsync($"api/MediaItem/{MediaItemId}/tv", Show);        
        if(response.IsSuccessStatusCode)
        {
            Console.WriteLine($"Updated TV Show: {Show.Title}");
            Toast.Success($"Updated TV Show:  {Show.Title}");
            await Task.Delay(5000);
            Nav.NavigateTo($"media/{MediaItemId}");
                    }
    }

    private void ShowToast()
    {
        Toast.Show("This is a toast message!");
    }

}
