<Blazor.Sonner.Toaster @rendermode="InteractiveServer" RichColors="@true"/>
@code {
    [Parameter]
    public int MediaItemId { get; set; }
    [Parameter]
    /*public UpdateTelevisionShowDto? Show{ get; set; }
    public CreateTelevisionShowDto NewShow = new();*/
    public UpdateTelevisionEpisodeDto Episode{ get; set; }
    public CreateTelevisionEpisodeDto NewEpisode { get; set; } = new();
    private EditContext EC;
    private int mediaTypeInt;
    private List<TelevisionShowDto> shows = new List<TelevisionShowDto>();
    private List<TelevisionSeasonDto> existingSeasons = new List<TelevisionSeasonDto>();

    private UpdateTelevisionShowDto newTelevisionShow = new UpdateTelevisionShowDto();

    private BSModal? newShowModal = new BSModal();
    private BSModal? newSeasonModal = new BSModal();
    protected async override Task OnParametersSetAsync()
    {
        EC = new EditContext(NewEpisode);
        if (Episode != null)
        {
            NewEpisode = Episode.ToCreateTelevisionEpisode();
        }
        shows = await Http.GetFromJsonAsync<List<TelevisionShowDto>>("api/Collections/shows");
    }

    protected async Task ModifyMediaItem()
    {
        NewEpisode.MediaType = MediaTypeValue.TV;
        if(MediaItemId != 0)
        {
            //NewEpisode.Lo
            //Episode = NewEpisode.LoadFromCreate(NewEpisode, Episode);
            //Show = Show?.LoadFromCreate(NewShow, Show);
            await UpdateMediaItem();
        }
        else
        {
            await CreateMediaItem();
        }
    }

    protected async Task CreateMediaItem()
    {
        Console.WriteLine($"TV Episode Details: {NewEpisode}");
        var response = await Http.PostAsJsonAsync<CreateTelevisionEpisodeDto>("api/MediaItem/tv", NewEpisode);
        if(response.IsSuccessStatusCode)
        {
            TelevisionEpisodeDto responseValue = await response.Content.ReadFromJsonAsync<TelevisionEpisodeDto>();
            if(responseValue != null)
            {
                Console.WriteLine($"Created TV Episode: {responseValue.Title}");
                Toast.Success($"Created TV Episode: {responseValue.Title}");
            }
        }
        else
        {
            Toast.Error($"Could not create TV Episode: {response.ReasonPhrase}");
        }
    }

    protected async Task UpdateMediaItem()
    {
        Toast.Show("Updating TV Episode...");
        var response = await Http.PutAsJsonAsync($"api/MediaItem/{MediaItemId}/tv", Episode);        
        if(response.IsSuccessStatusCode)
        {
            Console.WriteLine($"Updated TV Episode: {Episode.Title}");
            Toast.Success($"Updated TV Episode:  {Episode.Title}");
            await Task.Delay(5000);
            Nav.NavigateTo($"media/{MediaItemId}");
        }
    }

    private void TVShowChanged(ChangeEventArgs e)
    {
        var selectedShowId = Convert.ToInt32(e.Value);
        if (selectedShowId == 0)
        {

        }
        else
        {
            if (selectedShowId == -1)
            {
                // Handle the "New Show" option
                Console.WriteLine("New Show selected");
                DisplayShowModal();
                // You can navigate to a new page or show a modal for creating a new show here
            }
            else
            {
                existingSeasons = Http.GetFromJsonAsync<List<TelevisionSeasonDto>>($"api/Collections/shows/{selectedShowId}/seasons").Result;
                // Handle the selection of an existing show
                // Console.WriteLine($"Selected Show ID: {selectedShowId}");
                NewEpisode.TelevisionShowId = selectedShowId;
            }
        }
    }

    private async Task DisplayShowModal()
    {
        await newShowModal.ShowAsync();
    }

    private void ShowToast()
    {
        Toast.Show("This is a toast message!");
    }

}
