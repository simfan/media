@page "/media/create";
@page "/media/create/{MediaType}"
@using Microsoft.AspNetCore.Components;
@using Blazor.Sonner;
@using Blazor.Sonner.Services;
@using Medias.Client.Components.Components;
@using Medias.Shared.DTOs;
@using Medias.Shared.Enums;
@using Medias.Shared.Helpers;

<h3>New Media Item</h3>
<div class="@(BS.Form_Floating) mb-1">
                    <BSInput InputType="InputType.Select" @bind-Value="selectedMediaType" @onchange="MediaTypeChanged">
                        @foreach (var mediaType in Enum.GetValues<MediaTypeValue>())
                        {
                            <option value="@mediaType">
                                @mediaType.GetDisplayName()
                            </option>
                        }
                    </BSInput>
                    <BSLabel IsFloating="true">Media Type</BSLabel>
                </div>

                        @switch (selectedMediaType)
                        {
                            case MediaTypeValue.Book:
                                <EditBook MediaItemId=0 />
                                break;
                            case MediaTypeValue.Movie:
                                <EditMovie MediaItemId=0/>
                                
                                break;
                            case MediaTypeValue.TV:
                                <EditTV MediaItemId=0/>
                                break;
                            case MediaTypeValue.Music:
                                <EditMusic MediaItemId="0" />
                                break;
                            default:
                                <EditMediaItem MediaItemId="0"/>
                                break;
                        }
                       


<div></div>
@code {
    [Parameter]
    public string? MediaType{ get; set; }
    private MediaTypeValue selectedMediaType;// = MediaTypeValue.Other;

    protected override void OnParametersSet()
    {
        switch(MediaType)
        {
            case "movie":
                selectedMediaType= MediaTypeValue.Movie;
                break;
            case "tv":
                selectedMediaType = MediaTypeValue.TV;
                break;
            case "music":
                selectedMediaType = MediaTypeValue.Music;
                break;
            default:
                selectedMediaType = MediaTypeValue.Other;
                break;
        }
    }

    private void MediaTypeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<MediaTypeValue>(e.Value?.ToString(), out var mediaType))
        {
            selectedMediaType = mediaType;
        }
    }
}