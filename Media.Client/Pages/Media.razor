@page "/media"
@using Medias.Shared
@using Medias.Shared.DTOs
@using Medias.Shared.Enums
@inject HttpClient Http
@inject NavigationManager Nav
<h3>Media</h3>

<div>
    @if (mediaItems == null)
    {
        <p>Loading media items...</p>
    }
    else
    {
        <BSNav IsTabs ="true">
            <BSNavItem>
                <TabLabel>Online</TabLabel>
                <TabContent>
                    <BSCard CardType="CardType.Card">
                        <BSCard CardType="CardType.Header">Search Online</BSCard>
                        <BSCard CardType="CardType.Body">
                            <BSRow>
                                <BSCol ColumnLarge="9">
                                    <div>
                                        <div class="@(BS.Form_Floating) mb-1">
                                            <BSInput InputType="InputType.Text" @bind-Value="onlineSearchValue" />
                                            <BSLabel IsFloating="true">Search:</BSLabel>
                                        </div>
                                    </div>
                                </BSCol>
                                <BSCol ColumnLarge="3">
                                <BSDropdown>
                                    <Toggler>
                                        <BSButton Color="BSColor.Primary">Search</BSButton>
                                        <BSToggle IsButton ="true" Color="BSColor.Primary" IsSplitButton="true"></BSToggle>
                                    </Toggler>
                                    <Content>
                                        <BSDropdownItem OnClick="TMDbMovieSearch">Movie</BSDropdownItem>
                                        <BSDropdownItem OnClick="TMDbTVSearch">TV</BSDropdownItem>
                                        <BSDropdownItem OnClick="MusicBrainzRecordingSearch">Music (Song)</BSDropdownItem>
                                        <BSDropdownItem OnClick="MusicBrainzAlbumSearch">Music (Album)</BSDropdownItem>
                                        <BSDropdownItem OnClick="OpenLibrarySearch">Book</BSDropdownItem>
                                    </Content>
                                </BSDropdown>
                                </BSCol>
                            </BSRow>
                        </BSCard>
                    </BSCard>
                    @if(searchResults != null && searchResults.Count> 0)
                    {
                        foreach(var searchResult in searchResults)
                        {
                            <BSCard CardType="CardType.Card">
                                <BSCard CardType="CardType.Header">
                                    <div class="text-end"><BSButton>Import</BSButton></div>
                                </BSCard>
                                <BSCard CardType="CardType.Body">
                                    <BSRow>
                                        <BSCol>
                                            <h4>@searchResult.Title</h4>
                                            <span>@searchResult.ReleaseDate</span>
                                            <p>@searchResult.Description</p>
                                        </BSCol>
                                        <BSCol>
                                            @if(!string.IsNullOrEmpty(searchResult.PosterPath))
                                            {
                                                <BSImage Source="@searchResult.PosterPath" Class=@searchClass />
                                            }
                                        </BSCol>
                                    </BSRow>
                                </BSCard>
                            </BSCard>
                        }
                    }   

                    @*if(movieSearchResults != null && movieSearchResults.Count > 0)
                    {
                        foreach(var movieSearchResult in movieSearchResults)
                        {
                            <BSCard CardType="CardType.Card">
                                <BSCard CardType="CardType.Header">
                                    <div class="text-end"><BSButton OnClick="(() => NavToImportMovie(movieSearchResult.ID))">Import</BSButton></div>
                                </BSCard>
                                <BSCard CardType="CardType.Body">
                                    <BSRow>
                                        <BSCol>
                                            <h4>@movieSearchResult.Title</h4>
                                            <span>@movieSearchResult.Release_Date</span>
                                            <p>@movieSearchResult.Overview</p>
                                        </BSCol>
                                        <BSCol>
                                            <BSImage Source="@($"https://image.tmdb.org/t/p/w500{movieSearchResult.Poster_Path}")" />
                                        </BSCol>
                                    </BSRow>
                                </BSCard>
                            </BSCard>
                        }
                    }
                    @if(tvSearchResults != null && tvSearchResults.Count >0)
                    {
                        foreach (var tvSearchResult in tvSearchResults)
                        {
                        <BSCard CardType="CardType.Card">
                            <BSCard CardType="CardType.Header">
                                <div class="text-end"><BSButton>Import</BSButton></div>
                            </BSCard>
                            <BSCard CardType="CardType.Body">
                                <BSRow>
                                    <BSCol>
                                        <h4>@tvSearchResult.Name</h4>
                                        <span>@tvSearchResult.First_Air_Date - @tvSearchResult.Last_Air_Date</span>
                                        <p>@tvSearchResult.Overview</p>
                                    </BSCol>
                                    <BSCol>
                                        <BSImage Source="@($"https://image.tmdb.org/t/p/w500{tvSearchResult.Poster_Path}")" />
                                    </BSCol>
                                </BSRow>
                            </BSCard>
                        </BSCard>
                        }
                    }*@
                </TabContent>
            </BSNavItem>
            @if(mediaItems.Count () >0)
            {
                <BSNavItem>
                    <TabLabel>Local</TabLabel>
                    <TabContent>
                        <BSCard CardType="CardType.Card">
                            <BSCard CardType="CardType.Header">
                                <BSRow>
                                    <BSCol ColumnLarge="1"><BSBadge>Filter</BSBadge></BSCol>
                                    <BSCol ColumnLarge="8">
                                        <BSInputRadio CheckedValue="@MediaTypeValue.Movie" @bind-Value="mediaFilter" IsToggle="true" @onchange="FilterMediaItems">Movie</BSInputRadio>
                                        <BSInputRadio CheckedValue="@MediaTypeValue.TV" @bind-Value="mediaFilter" IsToggle="true" @onchange="FilterMediaItems">TV</BSInputRadio>
                                        <BSInputRadio CheckedValue="@MediaTypeValue.Music" @bind-Value="mediaFilter" IsToggle="true" @onchange="FilterMediaItems">Music</BSInputRadio>
                                        <BSInputRadio CheckedValue="@MediaTypeValue.Other" @bind-Value="mediaFilter" IsToggle="true" @onchange="FilterMediaItems">Other</BSInputRadio>
                                    </BSCol>
                                    <BSCol ColumnLarge="3" Class="text-end">
                                        <BSButton Color="BSColor.Danger" OnClick="ClearFilter">Clear Filter</BSButton>
                                        <BSButton Color="BSColor.Success" OnClick="NavToCreate">Create</BSButton>
                                    </BSCol>
                                </BSRow>
                            </BSCard>
                            <BSCard CardType="CardType.Body">
                                <BSTable>
                                    <BSTHead>
                                        <BSTD>Media Type</BSTD>
                                        <BSTD>Title</BSTD>
                                        <BSTD>Description</BSTD>
                                        <BSTD>Location</BSTD>

                                    </BSTHead>
                                    <BSTBody>
                                        @foreach (var item in filteredMediaItems)
                                        {
                                            <BSTR @onclick="() => NavToDetails(item)">
                                                <BSTD>@item.MediaType</BSTD>
                                                <BSTD>@item.Title</BSTD>
                                                <BSTD>@item.Description</BSTD>
                                                <BSTD>@item.ThumbnailPath</BSTD>
                                            </BSTR>
                                        }
                                    </BSTBody>
                                </BSTable>
                            </BSCard>
                        </BSCard>
                    </TabContent>
                </BSNavItem>
            }
        </BSNav>
        
        @*if (mediaItems.Count() > 0)
        {
            <BSCard CardType="CardType.Card">
                <BSCard CardType="CardType.Header">
                    <BSRow>
                        <BSCol ColumnLarge="1"><BSBadge>Filter</BSBadge></BSCol>
                    <BSCol ColumnLarge="9">
                        <BSInputRadio CheckedValue="@MediaTypeValue.Movie" @bind-Value="mediaFilter" IsToggle="true" @onchange="FilterMediaItems">Movie</BSInputRadio>
                        <BSInputRadio CheckedValue="@MediaTypeValue.TV" @bind-Value="mediaFilter" IsToggle="true" @onchange="FilterMediaItems">TV</BSInputRadio>
                        <BSInputRadio CheckedValue="@MediaTypeValue.Other" @bind-Value="mediaFilter" IsToggle="true" @onchange="FilterMediaItems">Other</BSInputRadio>
                    </BSCol>
                    <BSCol ColumnLarge="2" Class="text-end"><BSButton Color="BSColor.Danger" OnClick="ClearFilter">Clear Filter</BSButton></BSCol>
                    </BSRow>
                </BSCard>
                <BSCard CardType="CardType.Body">
            <BSTable>
                <BSTHead>
                    <BSTD>Media Type</BSTD>
                    <BSTD>Title</BSTD>
                    <BSTD>Description</BSTD>
                    <BSTD>Location</BSTD>
                    
                </BSTHead>
                <BSTBody>
                @foreach (var item in filteredMediaItems)
                {
                    <BSTR>
                        <BSTD>@item.MediaType</BSTD>
                        <BSTD>@item.Title</BSTD>
                        <BSTD>@item.Description</BSTD>
                        <BSTD>@item.ThumbnailPath</BSTD>
                    </BSTR>
                }
                </BSTBody>
            </BSTable>
                </BSCard>
            </BSCard>
        }
        else
        {
            <p>No Media Items found. Please add some <a href="/media/create">here</a></p>
        }*@
    }
</div>
@code {
    private MediaItemDto[]? mediaItems;
    private MediaItemDto[]? filteredMediaItems;
    private MediaTypeValue? mediaFilter;

    private string? onlineSearchValue;
    private string searchClass = "";
    //private List<TMDbMovieSearchRecord>? movieSearchResults = new();
    //private List<TMDbTVSearchRecord>? tvSearchResults = new();
    private List<SearchResultDto>? musicSearchResults = new();
    private List<SearchResultDto>? searchResults = new();
    //private List<OpenLibrary>
    protected override async Task OnInitializedAsync()
    {
        // Simulate asynchronous loading to demonstrate streaming rendering
        await Task.Delay(500);

        mediaItems = await Http.GetFromJsonAsync<MediaItemDto[]>("api/MediaItem");
        filteredMediaItems = mediaItems;
    }

    private async Task TMDbMovieSearch()
    {
        try{
            ClearOnlineSearchFields();
            searchClass="movie-thumbnail";
            searchResults = await Http.GetFromJsonAsync<List<SearchResultDto>>($"api/tmdb/movie/search?title={onlineSearchValue}");
        }
        catch(Exception ex)
        {
            var baseException = ex.GetBaseException();

            Console.WriteLine($"TMDb Search Error: {ex.InnerException}");
            Console.WriteLine($"Root Cause: {baseException.Message}");
            Console.WriteLine($"Stack Trace: {ex.StackTrace}");
        }

    }

    private async Task TMDbTVSearch()
    {
        try
        {
            ClearOnlineSearchFields();
            searchClass = "tv-thumbnail";
            searchResults = await Http.GetFromJsonAsync<List<SearchResultDto>>($"api/tmdb/tv/search?name={onlineSearchValue}");
        }
        catch(Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private async Task MusicBrainzRecordingSearch()
    {
        ClearOnlineSearchFields();
        //musicSearchResults = await Http.GetFromJsonAsync<List<SearchResultDto>>($"api/musicbrainz/songs/search?title={onlineSearchValue}");
        searchClass="album-thumbnail";
        searchResults = await Http.GetFromJsonAsync<List<SearchResultDto>>($"api/musicbrainz/songs/search?title={onlineSearchValue}");

    }

    private async Task MusicBrainzAlbumSearch()
    {
        ClearOnlineSearchFields();
        searchClass="album-thumbnail";
        searchResults = await Http.GetFromJsonAsync<List<SearchResultDto>>($"api/musicbrainz/albums/search?title={onlineSearchValue}");
    }

    private async Task OpenLibrarySearch()
    {
        ClearOnlineSearchFields();
        searchClass="book-thumbnail";
        searchResults = await Http.GetFromJsonAsync<List<SearchResultDto>>($"api/openlibrary/search/books?title={onlineSearchValue}");
    }

    private void ClearOnlineSearchFields()
    {
        searchResults.Clear();
        //  movieSearchResults.Clear();
        //tvSearchResults.Clear();
        musicSearchResults.Clear();
    }

    private void FilterMediaItems()
    {
        filteredMediaItems = mediaItems.Where(mi => mi.MediaType == mediaFilter).ToArray();
    }

    private void ClearFilter()
    {
        mediaFilter = null;
        filteredMediaItems = mediaItems;
    }

    private void NavToCreate()
    {
        string? mediaFilterText;
        switch(mediaFilter)
        {
            case MediaTypeValue.Movie:
                mediaFilterText = "movie";
                break;
            case MediaTypeValue.TV:
                mediaFilterText = "tv";
                break;
            case MediaTypeValue.Music:
                mediaFilterText = "music";
                break;
            default:
                mediaFilterText = "";
                break;
        }
        Nav.NavigateTo($"/media/create/{mediaFilterText}");
    }

    private void NavToImportMovie(int tmdbId)
    {
        Nav.NavigateTo($"/import/movie/{tmdbId}");
    }
    
    private void NavToImportTVShow(int tmdbId)
    {
        Nav.NavigateTo($"/import/tv/show/{tmdbId}");
    }

    private void NavToDetails(MediaItemDto mediaItem)
    {
        Nav.NavigateTo($"/media/{mediaItem.Id}");
    }
}